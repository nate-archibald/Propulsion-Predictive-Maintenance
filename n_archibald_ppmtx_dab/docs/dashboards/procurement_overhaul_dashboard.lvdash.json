{
  "datasets": [
    {
      "name": "ds_procurement_kpis",
      "displayName": "Procurement KPIs",
      "queryLines": [
        "SELECT\n",
        "  COUNT(CASE WHEN o.status = 'Open' THEN 1 END) AS open_orders,\n",
        "  COALESCE(SUM(o.exchange_repair_cost), 0) AS total_repair_cost,\n",
        "  AVG(o.lead_time) AS avg_lead_time,\n",
        "  COALESCE(SUM(o.qty_received) * 1.0 / NULLIF(SUM(o.qty_require), 0), 0) AS fulfillment_rate\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_order o\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON o.order_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_order_status_by_type",
      "displayName": "Order Status by Type",
      "queryLines": [
        "SELECT\n",
        "  o.order_type,\n",
        "  o.status,\n",
        "  COUNT(*) AS order_count\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_order o\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON o.order_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "  AND o.order_type IS NOT NULL\n",
        "  AND o.status IS NOT NULL\n",
        "GROUP BY o.order_type, o.status\n",
        "ORDER BY order_count DESC\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_lead_time_trend",
      "displayName": "Lead Time Trend",
      "queryLines": [
        "SELECT\n",
        "  DATE_TRUNC('MONTH', d.calendar_date) AS month_start,\n",
        "  AVG(o.lead_time) AS avg_lead_time\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_order o\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON o.order_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "  AND o.lead_time IS NOT NULL\n",
        "GROUP BY DATE_TRUNC('MONTH', d.calendar_date)\n",
        "ORDER BY month_start\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_repair_cost_quarterly",
      "displayName": "Repair Cost by Quarter",
      "queryLines": [
        "SELECT\n",
        "  order_type,\n",
        "  DATE_TRUNC('QUARTER', d.calendar_date) AS quarter_start,\n",
        "  SUM(o.exchange_repair_cost) AS repair_cost\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_order o\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON o.order_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "  AND o.exchange_repair_cost IS NOT NULL\n",
        "GROUP BY o.order_type, DATE_TRUNC('QUARTER', d.calendar_date)\n",
        "ORDER BY quarter_start\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_fulfillment_trend",
      "displayName": "Fulfillment Rate Trend",
      "queryLines": [
        "SELECT\n",
        "  DATE_TRUNC('MONTH', d.calendar_date) AS month_start,\n",
        "  SUM(o.qty_received) * 1.0 / NULLIF(SUM(o.qty_require), 0) AS fulfillment_rate\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_order o\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON o.order_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "GROUP BY DATE_TRUNC('MONTH', d.calendar_date)\n",
        "ORDER BY month_start\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_top_shop_findings",
      "displayName": "Top Shop Findings",
      "queryLines": [
        "SELECT\n",
        "  COALESCE(c.chapter_description, CAST(c.chapter AS STRING)) AS finding_category,\n",
        "  COUNT(*) AS finding_count\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_teardown t\n",
        "LEFT JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_ata_chapter c ON t.dim_ata_chapter_key = c.dim_ata_chapter_key\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON t.created_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "GROUP BY c.chapter_description, c.chapter\n",
        "ORDER BY finding_count DESC\n",
        "LIMIT 10\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_overdue_orders",
      "displayName": "Overdue Orders",
      "queryLines": [
        "SELECT\n",
        "  o.order_type,\n",
        "  o.order_number,\n",
        "  o.order_line,\n",
        "  p.pn,\n",
        "  COALESCE(p.pn_description, p.pn) AS part_name,\n",
        "  o.status,\n",
        "  o.lead_time,\n",
        "  o.qty_require,\n",
        "  o.qty_received,\n",
        "  o.exchange_repair_cost\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_order o\n",
        "LEFT JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_part p ON o.dim_part_key = p.dim_part_key\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON o.order_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "  AND o.status = 'Open'\n",
        "  AND o.lead_time > 30\n",
        "ORDER BY o.lead_time DESC\n",
        "LIMIT 50\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_filter_order_type",
      "displayName": "Filter Order Type",
      "queryLines": [
        "SELECT DISTINCT order_type\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_order\n",
        "WHERE order_type IS NOT NULL\n",
        "ORDER BY order_type\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_filter_status",
      "displayName": "Filter Status",
      "queryLines": [
        "SELECT DISTINCT status\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_order\n",
        "WHERE status IS NOT NULL\n",
        "ORDER BY status\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    }
  ],
