{
  "datasets": [
    {
      "name": "ds_defect_kpis",
      "displayName": "Defect KPIs",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS total_defects,\n",
        "  COUNT(CASE WHEN f.delay = 'Y' THEN 1 END) AS delay_events,\n",
        "  COUNT(CASE WHEN f.cancellation = 'Y' THEN 1 END) AS cancellations,\n",
        "  COUNT(CASE WHEN f.i_f_s_d = 'Y' THEN 1 END) AS ifsds,\n",
        "  COALESCE(SUM(f.delays_hours), 0) AS total_delay_hours,\n",
        "  COUNT(CASE WHEN f.defer = 'Y' OR f.mel = 'Y' THEN 1 END) AS deferrals\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_defect f\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON f.reported_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_defect_trend_weekly",
      "displayName": "Defect Trend Weekly",
      "queryLines": [
        "SELECT\n",
        "  DATE_TRUNC('WEEK', d.calendar_date) AS week_start,\n",
        "  COUNT(*) AS defect_count,\n",
        "  COUNT(CASE WHEN f.delay = 'Y' THEN 1 END) AS delay_events\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_defect f\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON f.reported_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "GROUP BY DATE_TRUNC('WEEK', d.calendar_date)\n",
        "ORDER BY week_start\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_top_ata_by_delays",
      "displayName": "Top ATA by Delay Minutes",
      "queryLines": [
        "SELECT\n",
        "  c.chapter_description,\n",
        "  COALESCE(SUM(f.delay_minutes), 0) AS delay_minutes\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_defect f\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_ata_chapter c ON f.dim_ata_chapter_key = c.dim_ata_chapter_key\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON f.reported_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "  AND c.chapter_description IS NOT NULL\n",
        "GROUP BY c.chapter_description\n",
        "ORDER BY delay_minutes DESC\n",
        "LIMIT 10\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_cancellation_trend",
      "displayName": "Cancellation Trend Monthly",
      "queryLines": [
        "SELECT\n",
        "  DATE_TRUNC('MONTH', d.calendar_date) AS month_start,\n",
        "  COUNT(CASE WHEN f.cancellation = 'Y' THEN 1 END) AS cancellation_count\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_defect f\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON f.reported_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "GROUP BY DATE_TRUNC('MONTH', d.calendar_date)\n",
        "ORDER BY month_start\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_deferral_analysis",
      "displayName": "Deferral Analysis",
      "queryLines": [
        "SELECT\n",
        "  CASE\n",
        "    WHEN f.mel = 'Y' THEN 'MEL Deferral'\n",
        "    WHEN f.defer = 'Y' THEN 'Non-MEL Deferral'\n",
        "    ELSE 'No Deferral'\n",
        "  END AS deferral_type,\n",
        "  f.status,\n",
        "  COUNT(*) AS defect_count\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_defect f\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON f.reported_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "GROUP BY\n",
        "  CASE WHEN f.mel = 'Y' THEN 'MEL Deferral' WHEN f.defer = 'Y' THEN 'Non-MEL Deferral' ELSE 'No Deferral' END,\n",
        "  f.status\n",
        "ORDER BY defect_count DESC\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_defect_part_linkage",
      "displayName": "Defect-Part Linkage Coverage",
      "queryLines": [
        "SELECT\n",
        "  COUNT(DISTINCT f.fact_defect_key) AS total_defects,\n",
        "  COUNT(DISTINCT b.bridge_defect_part_key) AS linked_defects,\n",
        "  COALESCE(COUNT(DISTINCT b.bridge_defect_part_key) * 1.0 / NULLIF(COUNT(DISTINCT f.fact_defect_key), 0), 0) AS linkage_rate\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_defect f\n",
        "LEFT JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_bridge_defect_part b\n",
        "  ON f.defect_type = b.defect_type AND f.defect = b.defect AND f.defect_item = b.defect_item\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d\n",
        "  ON f.reported_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_recent_defects",
      "displayName": "Recent Defects",
      "queryLines": [
        "SELECT\n",
        "  f.defect_type,\n",
        "  f.defect,\n",
        "  f.defect_description,\n",
        "  a.ac AS aircraft,\n",
        "  c.chapter,\n",
        "  c.chapter_description,\n",
        "  d.calendar_date AS reported_date,\n",
        "  f.status,\n",
        "  f.delay_minutes,\n",
        "  f.cancellation,\n",
        "  f.i_f_s_d AS ifsd\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_defect f\n",
        "LEFT JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_aircraft a ON f.dim_aircraft_key = a.dim_aircraft_key\n",
        "LEFT JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_ata_chapter c ON f.dim_ata_chapter_key = c.dim_ata_chapter_key\n",
        "LEFT JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON f.reported_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "ORDER BY d.calendar_date DESC\n",
        "LIMIT 100\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_filter_ata_chapters",
      "displayName": "Filter ATA Chapters",
      "queryLines": [
        "SELECT DISTINCT chapter_description\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_ata_chapter\n",
        "WHERE chapter_description IS NOT NULL\n",
        "ORDER BY chapter_description\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_filter_aircraft",
      "displayName": "Filter Aircraft",
      "queryLines": [
        "SELECT DISTINCT ac\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_aircraft\n",
        "WHERE ac IS NOT NULL\n",
        "ORDER BY ac\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_filter_defect_type",
      "displayName": "Filter Defect Type",
      "queryLines": [
        "SELECT DISTINCT defect_type\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_defect\n",
        "WHERE defect_type IS NOT NULL\n",
        "ORDER BY defect_type\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    }
  ],
