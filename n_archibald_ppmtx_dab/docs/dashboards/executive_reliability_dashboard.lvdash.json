{
  "datasets": [
    {
      "name": "ds_defect_kpis",
      "displayName": "Defect KPIs",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS total_defects,\n",
        "  COALESCE(SUM(f.delays_hours), 0) AS total_delay_hours,\n",
        "  COUNT(CASE WHEN f.cancellation = 'Y' THEN 1 END) AS cancellations,\n",
        "  COUNT(CASE WHEN f.i_f_s_d = 'Y' THEN 1 END) AS ifsds\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_defect f\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON f.reported_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_mtbur_kpi",
      "displayName": "Fleet MTBUR KPI",
      "queryLines": [
        "SELECT\n",
        "  AVG(f.hours_installed) AS fleet_mtbur\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_component_removal f\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON f.transaction_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "  AND f.hours_installed IS NOT NULL\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_top_ata_delays",
      "displayName": "Top 10 ATA by Delay Minutes",
      "queryLines": [
        "SELECT\n",
        "  c.chapter_description,\n",
        "  COALESCE(SUM(f.delay_minutes), 0) AS delay_minutes\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_defect f\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_ata_chapter c ON f.dim_ata_chapter_key = c.dim_ata_chapter_key\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON f.reported_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "  AND c.chapter_description IS NOT NULL\n",
        "GROUP BY c.chapter_description\n",
        "ORDER BY delay_minutes DESC\n",
        "LIMIT 10\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_top_pn_cancellations",
      "displayName": "Top 10 P/Ns by Cancellations",
      "queryLines": [
        "SELECT\n",
        "  COALESCE(p.pn_description, p.pn) AS part_name,\n",
        "  COUNT(*) AS removal_count\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_component_removal f\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_part p ON f.dim_part_key = p.dim_part_key\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON f.transaction_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "  AND f.schedule_category = 'Unscheduled'\n",
        "GROUP BY p.pn, p.pn_description\n",
        "ORDER BY removal_count DESC\n",
        "LIMIT 10\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_defect_trend_weekly",
      "displayName": "Fleet Defect Trend Weekly",
      "queryLines": [
        "SELECT\n",
        "  DATE_TRUNC('WEEK', d.calendar_date) AS week_start,\n",
        "  COUNT(*) AS defect_count\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_defect f\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON f.reported_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "GROUP BY DATE_TRUNC('WEEK', d.calendar_date)\n",
        "ORDER BY week_start\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_mtbur_trend",
      "displayName": "Fleet MTBUR Trend",
      "queryLines": [
        "SELECT\n",
        "  DATE_TRUNC('MONTH', d.calendar_date) AS month_start,\n",
        "  AVG(f.hours_installed) AS fleet_mtbur\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_component_removal f\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON f.transaction_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "  AND f.hours_installed IS NOT NULL\n",
        "GROUP BY DATE_TRUNC('MONTH', d.calendar_date)\n",
        "ORDER BY month_start\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_dq_scorecard",
      "displayName": "Data Quality Scorecard",
      "queryLines": [
        "SELECT 'Defect-Part Linkage' AS metric,\n",
        "  COALESCE(COUNT(DISTINCT b.bridge_defect_part_key) * 1.0 / NULLIF(COUNT(DISTINCT f.fact_defect_key), 0), 0) AS score\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_defect f\n",
        "LEFT JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_bridge_defect_part b\n",
        "  ON f.defect_type = b.defect_type AND f.defect = b.defect AND f.defect_item = b.defect_item\n",
        "UNION ALL\n",
        "SELECT 'Removal FK Coverage' AS metric,\n",
        "  COALESCE(COUNT(dim_part_key) * 1.0 / NULLIF(COUNT(*), 0), 0) AS score\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_component_removal\n",
        "UNION ALL\n",
        "SELECT 'Defect ATA Coverage' AS metric,\n",
        "  COALESCE(COUNT(dim_ata_chapter_key) * 1.0 / NULLIF(COUNT(*), 0), 0) AS score\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_defect\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_inventory_health",
      "displayName": "Inventory Health Summary",
      "queryLines": [
        "SELECT\n",
        "  COUNT(CASE WHEN s.condition = 'SVC' THEN 1 END) * 1.0 / NULLIF(COUNT(*), 0) AS serviceable_ratio,\n",
        "  COUNT(CASE WHEN s.condition = 'AOG' THEN 1 END) AS aog_count,\n",
        "  COUNT(*) AS total_instances\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_inventory_snapshot s\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_filter_ata_chapters",
      "displayName": "Filter ATA Chapters",
      "queryLines": [
        "SELECT DISTINCT chapter_description\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_ata_chapter\n",
        "WHERE chapter_description IS NOT NULL\n",
        "ORDER BY chapter_description\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    }
  ],
