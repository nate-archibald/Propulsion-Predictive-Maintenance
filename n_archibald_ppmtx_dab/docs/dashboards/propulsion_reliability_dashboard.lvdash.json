{
  "datasets": [
    {
      "name": "ds_reliability_kpis",
      "displayName": "Reliability KPIs",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS removal_count,\n",
        "  AVG(f.hours_installed) AS avg_hours_at_removal,\n",
        "  AVG(f.cycles_installed) AS avg_cycles_at_removal,\n",
        "  COUNT(CASE WHEN f.schedule_category = 'Unscheduled' THEN 1 END) AS unscheduled_count\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_component_removal f\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON f.transaction_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_removal_trend_weekly",
      "displayName": "Removal Trend Weekly",
      "queryLines": [
        "SELECT\n",
        "  DATE_TRUNC('WEEK', d.calendar_date) AS week_start,\n",
        "  COUNT(*) AS removal_count,\n",
        "  COUNT(CASE WHEN f.schedule_category = 'Unscheduled' THEN 1 END) AS unscheduled_count,\n",
        "  COUNT(CASE WHEN f.schedule_category = 'Scheduled' THEN 1 END) AS scheduled_count\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_component_removal f\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON f.transaction_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "GROUP BY DATE_TRUNC('WEEK', d.calendar_date)\n",
        "ORDER BY week_start\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_mtbur_by_part",
      "displayName": "MTBUR by Part Number",
      "queryLines": [
        "SELECT\n",
        "  p.pn,\n",
        "  COALESCE(p.pn_description, p.pn) AS part_name,\n",
        "  AVG(f.hours_installed) AS mtbur_hours,\n",
        "  COUNT(*) AS removal_count\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_component_removal f\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_part p ON f.dim_part_key = p.dim_part_key\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON f.transaction_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "  AND p.pn IS NOT NULL\n",
        "GROUP BY p.pn, p.pn_description\n",
        "ORDER BY mtbur_hours ASC\n",
        "LIMIT 15\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_removals_by_ata",
      "displayName": "Removals by ATA Chapter",
      "queryLines": [
        "SELECT\n",
        "  c.chapter_description,\n",
        "  COUNT(*) AS removal_count,\n",
        "  COUNT(CASE WHEN f.schedule_category = 'Unscheduled' THEN 1 END) AS unscheduled_count\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_component_removal f\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_ata_chapter c ON f.dim_ata_chapter_key = c.dim_ata_chapter_key\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON f.transaction_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "  AND c.chapter_description IS NOT NULL\n",
        "GROUP BY c.chapter_description\n",
        "ORDER BY removal_count DESC\n",
        "LIMIT 10\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_removals_by_station",
      "displayName": "Removals by Station",
      "queryLines": [
        "SELECT\n",
        "  COALESCE(s.station_name, s.station_code) AS station,\n",
        "  COUNT(*) AS removal_count\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_component_removal f\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_station s ON f.dim_station_key = s.dim_station_key\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON f.transaction_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "  AND s.station_code IS NOT NULL\n",
        "GROUP BY s.station_name, s.station_code\n",
        "ORDER BY removal_count DESC\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_sched_unsched_trend",
      "displayName": "Scheduled vs Unscheduled Trend",
      "queryLines": [
        "SELECT\n",
        "  DATE_TRUNC('MONTH', d.calendar_date) AS month_start,\n",
        "  f.schedule_category,\n",
        "  COUNT(*) AS removal_count\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_component_removal f\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON f.transaction_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "  AND f.schedule_category IS NOT NULL\n",
        "GROUP BY DATE_TRUNC('MONTH', d.calendar_date), f.schedule_category\n",
        "ORDER BY month_start\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_reason_breakdown",
      "displayName": "Reason Category Breakdown",
      "queryLines": [
        "SELECT\n",
        "  COALESCE(f.reason_category, 'Unknown') AS reason_category,\n",
        "  COUNT(*) AS removal_count\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_component_removal f\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON f.transaction_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "GROUP BY f.reason_category\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_removal_by_tail",
      "displayName": "Removals by Aircraft Tail",
      "queryLines": [
        "SELECT\n",
        "  a.ac AS aircraft,\n",
        "  a.aircraft_type,\n",
        "  COUNT(*) AS removal_count,\n",
        "  COALESCE(AVG(f.hours_installed), 0) AS avg_hours\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_component_removal f\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_aircraft a\n",
        "  ON f.dim_aircraft_key = a.dim_aircraft_key\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d\n",
        "  ON f.transaction_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "GROUP BY a.ac, a.aircraft_type\n",
        "ORDER BY removal_count DESC\n",
        "LIMIT 10\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_filter_part_numbers",
      "displayName": "Filter Part Numbers",
      "queryLines": [
        "SELECT DISTINCT pn, COALESCE(pn_description, pn) AS pn_label\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_part\n",
        "WHERE pn IS NOT NULL\n",
        "ORDER BY pn\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_filter_stations",
      "displayName": "Filter Stations",
      "queryLines": [
        "SELECT DISTINCT station_code\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_station\n",
        "WHERE station_code IS NOT NULL\n",
        "ORDER BY station_code\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_filter_ata_chapters",
      "displayName": "Filter ATA Chapters",
      "queryLines": [
        "SELECT DISTINCT chapter_description\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_ata_chapter\n",
        "WHERE chapter_description IS NOT NULL\n",
        "ORDER BY chapter_description\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    }
  ],
