{
  "datasets": [
    {
      "name": "ds_inventory_kpis",
      "displayName": "Inventory KPIs",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS total_instances,\n",
        "  COUNT(CASE WHEN s.condition = 'SVC' THEN 1 END) AS serviceable_count,\n",
        "  COUNT(CASE WHEN s.condition = 'AOG' THEN 1 END) AS aog_count,\n",
        "  COALESCE(SUM(s.unit_cost), 0) AS total_value\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_inventory_snapshot s\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_spare_by_station",
      "displayName": "Spare Availability by Station",
      "queryLines": [
        "SELECT\n",
        "  COALESCE(st.station_name, st.station_code) AS station,\n",
        "  s.condition,\n",
        "  COUNT(*) AS instance_count\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_inventory_snapshot s\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_station st ON s.dim_station_key = st.dim_station_key\n",
        "WHERE st.station_code IS NOT NULL\n",
        "  AND s.condition IS NOT NULL\n",
        "GROUP BY st.station_name, st.station_code, s.condition\n",
        "ORDER BY instance_count DESC\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_stockout_risk",
      "displayName": "Stock-Out Risk",
      "queryLines": [
        "SELECT\n",
        "  p.pn,\n",
        "  COALESCE(p.pn_description, p.pn) AS part_name,\n",
        "  COUNT(CASE WHEN s.condition = 'SVC' THEN 1 END) AS serviceable_qty,\n",
        "  COUNT(*) AS total_qty\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_inventory_snapshot s\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_part p ON s.dim_part_key = p.dim_part_key\n",
        "WHERE s.condition IS NOT NULL\n",
        "GROUP BY p.pn, p.pn_description\n",
        "HAVING COUNT(CASE WHEN s.condition = 'SVC' THEN 1 END) < 3\n",
        "ORDER BY serviceable_qty ASC\n",
        "LIMIT 20\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_llp_redline",
      "displayName": "LLP Red-Line Fleet Scan",
      "queryLines": [
        "SELECT\n",
        "  p.pn,\n",
        "  COALESCE(p.pn_description, p.pn) AS part_name,\n",
        "  c.sn,\n",
        "  c.control AS control_type,\n",
        "  c.remaining_cycles,\n",
        "  c.remaining_hours,\n",
        "  c.schedule_cycles AS limit_cycles,\n",
        "  c.schedule_hours AS limit_hours\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_inventory_control c\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_part p ON c.dim_part_key = p.dim_part_key\n",
        "WHERE c.remaining_cycles < 1000 OR c.remaining_hours < 2000\n",
        "ORDER BY COALESCE(c.remaining_cycles, 999999) ASC\n",
        "LIMIT 25\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_condition_distribution",
      "displayName": "Condition Code Distribution",
      "queryLines": [
        "SELECT\n",
        "  COALESCE(s.condition, 'Unknown') AS condition,\n",
        "  COUNT(*) AS instance_count\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_inventory_snapshot s\n",
        "GROUP BY s.condition\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_inventory_movement",
      "displayName": "Inventory Movement Trend",
      "queryLines": [
        "SELECT\n",
        "  DATE_TRUNC('MONTH', d.calendar_date) AS month_start,\n",
        "  t.transaction_type,\n",
        "  COUNT(*) AS transaction_count\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_inventory_transaction t\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_date d ON t.transaction_date_key = d.dim_date_key\n",
        "WHERE d.calendar_date BETWEEN DATE_ADD(current_date(), -365) AND current_date()\n",
        "GROUP BY DATE_TRUNC('MONTH', d.calendar_date), t.transaction_type\n",
        "ORDER BY month_start\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_station_coverage",
      "displayName": "Station Coverage Summary",
      "queryLines": [
        "SELECT\n",
        "  COALESCE(st.station_name, st.station_code) AS station,\n",
        "  COUNT(*) AS total_parts,\n",
        "  COUNT(CASE WHEN s.condition = 'SVC' THEN 1 END) AS serviceable,\n",
        "  COUNT(CASE WHEN s.condition = 'AOG' THEN 1 END) AS aog_parts\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_inventory_snapshot s\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_station st ON s.dim_station_key = st.dim_station_key\n",
        "WHERE st.station_code IS NOT NULL\n",
        "GROUP BY st.station_name, st.station_code\n",
        "ORDER BY total_parts DESC\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_aog_parts",
      "displayName": "Parts on AOG Hold",
      "queryLines": [
        "SELECT\n",
        "  p.pn,\n",
        "  COALESCE(p.pn_description, p.pn) AS part_name,\n",
        "  s.sn,\n",
        "  COALESCE(st.station_name, st.station_code) AS station\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_inventory_snapshot s\n",
        "JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_part p ON s.dim_part_key = p.dim_part_key\n",
        "LEFT JOIN ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_station st ON s.dim_station_key = st.dim_station_key\n",
        "WHERE s.condition = 'AOG'\n",
        "ORDER BY p.pn\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_filter_part_numbers",
      "displayName": "Filter Part Numbers",
      "queryLines": [
        "SELECT DISTINCT pn\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_part\n",
        "WHERE pn IS NOT NULL\n",
        "ORDER BY pn\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_filter_stations",
      "displayName": "Filter Stations",
      "queryLines": [
        "SELECT DISTINCT station_code\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_dim_station\n",
        "WHERE station_code IS NOT NULL\n",
        "ORDER BY station_code\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    },
    {
      "name": "ds_filter_condition",
      "displayName": "Filter Condition",
      "queryLines": [
        "SELECT DISTINCT condition\n",
        "FROM ${catalog}.${gold_schema}.qx_ppmtx_gold_fact_inventory_snapshot\n",
        "WHERE condition IS NOT NULL\n",
        "ORDER BY condition\n"
      ],
      "catalog": "${catalog}",
      "schema": "${gold_schema}"
    }
  ],
